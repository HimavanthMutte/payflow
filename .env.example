# Environment Configuration
NODE_ENV=development
PORT=3000

# Database (PostgreSQL)
DATABASE_URL=postgresql://payflow_user:payflow_password@localhost:5432/payflow?schema=public

# Authentication & Security
JWT_SECRET=super_secret_payflow_key_minimum_32_characters_long!
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Rate Limiting & Networking
CORS_ORIGIN=http://localhost:5173
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# Business Limits (Paise: 1 INR = 100 paise)
MIN_PAYMENT_AMOUNT_PAISE=100
MAX_PAYMENT_AMOUNT_PAISE=500000000

# Logging
LOG_LEVEL=debug
